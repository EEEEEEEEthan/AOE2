config_version=5

[application]

config/name="AOE2 Framework"
config/description="Deterministic lockstep RTS framework: ECS + Q16.16 fixed point + flow-field pathfinding + 3D isometric presentation."
run/main_scene="res://presentation/main_menu.tscn"
config/features=PackedStringArray("4.8")
config/icon="res://icon.svg"

[autoload]

Settings="*res://presentation/settings_store.gd"
TestEntry="*res://tests/tools/_test_entry.gd"
MatchSetup="*res://presentation/match_setup.gd"

[engine_host]

version="4.8"
flavor="beta5"
install_directory="~/godots"
dotnet="true"

[dotnet]

project/assembly_name="AOE2Framework"

[test]

ignore_warning_pattern=""

[rendering]

renderer/rendering_method="forward_plus"
