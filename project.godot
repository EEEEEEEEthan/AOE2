config_version=5

[application]

config/name="AOE2 Framework"
config/description="Deterministic lockstep RTS framework: ECS + Q16.16 fixed point + flow-field pathfinding + 3D isometric presentation."
run/main_scene="res://presentation/main.tscn"
config/features=PackedStringArray("4.8")
config/icon="res://icon.svg"

[autoload]

TestEntry="*res://tests/tools/_test_entry.gd"

[engine_host]

version="4.8"
flavor="beta5"
install_directory="~/godots"
dotnet="false"

[test]

ignore_warning_pattern=""

[rendering]

renderer/rendering_method="forward_plus"
