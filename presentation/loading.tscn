[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://presentation/loading.gd" id="1_loading"]

[node name="Loading" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_loading")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.11, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
text = "正在加载对局"
horizontal_alignment = 1

[node name="MapNameLabel" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "地图：阿拉伯"
horizontal_alignment = 1

[node name="PlayersTitle" type="Label" parent="Center/Content"]
layout_mode = 2
text = "参战玩家"

[node name="PlayersList" type="VBoxContainer" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="ProgressBar" type="ProgressBar" parent="Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
max_value = 100.0
value = 0.0
show_percentage = false

[node name="ProgressLabel" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "准备中…　0%"
horizontal_alignment = 1

[node name="TipLabel" type="Label" parent="Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
text = "提示"
horizontal_alignment = 1
autowrap_mode = 2

[node name="ErrorLabel" type="Label" parent="Center/Content"]
