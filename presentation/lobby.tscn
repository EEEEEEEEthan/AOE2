[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://presentation/lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.11, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 40

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "多人联机"

[node name="Subtitle" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "创建房间作为房主，或填入房主地址加入同一房间。"

[node name="ConnectionRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="NameCaption" type="Label" parent="Margin/Content/ConnectionRow"]
layout_mode = 2
text = "名称"

[node name="NameEdit" type="LineEdit" parent="Margin/Content/ConnectionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2

[node name="AddressCaption" type="Label" parent="Margin/Content/ConnectionRow"]
layout_mode = 2
text = "地址"

[node name="AddressEdit" type="LineEdit" parent="Margin/Content/ConnectionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
text = "127.0.0.1"

[node name="PortCaption" type="Label" parent="Margin/Content/ConnectionRow"]
layout_mode = 2
text = "端口"

[node name="PortSpin" type="SpinBox" parent="Margin/Content/ConnectionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
min_value = 1.0
max_value = 65535.0
value = 27015.0

[node name="ActionRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HostButton" type="Button" parent="Margin/Content/ActionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
text = "创建房间"

[node name="JoinButton" type="Button" parent="Margin/Content/ActionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
text = "加入房间"

[node name="BackButton" type="Button" parent="Margin/Content/ActionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
text = "返回主菜单"

[node name="StatusLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "输入名称后创建房间，或填写房主地址加入。"

[node name="RoomPanel" type="PanelContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="RoomMargin" type="MarginContainer" parent="Margin/Content/RoomPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="RoomContent" type="VBoxContainer" parent="Margin/Content/RoomPanel/RoomMargin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="RoomTitle" type="Label" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent"]
layout_mode = 2
text = "房间"

[node name="RoomInfo" type="Label" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent"]
unique_name_in_owner = true
layout_mode = 2
text = "地图：阿拉伯"

[node name="SlotsList" type="VBoxContainer" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="RoomControls" type="HBoxContainer" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ColorCaption" type="Label" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls"]
layout_mode = 2
text = "颜色"

[node name="ColorOption" type="OptionButton" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2

[node name="ReadyCheck" type="CheckButton" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls"]
unique_name_in_owner = true
layout_mode = 2
text = "准备"

[node name="StartButton" type="Button" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "开始对局"

[node name="LeaveButton" type="Button" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
text = "离开房间"

[node name="RoomError" type="Label" parent="Margin/Content/RoomPanel/RoomMargin/RoomContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.45, 0.4, 1)
text = ""

[connection signal="pressed" from="Margin/Content/ActionRow/HostButton" to="." method="_on_host_pressed"]
[connection signal="pressed" from="Margin/Content/ActionRow/JoinButton" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Margin/Content/ActionRow/BackButton" to="." method="_on_back_pressed"]
[connection signal="item_selected" from="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls/ColorOption" to="." method="_on_color_selected"]
[connection signal="toggled" from="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls/ReadyCheck" to="." method="_on_ready_toggled"]
[connection signal="pressed" from="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Margin/Content/RoomPanel/RoomMargin/RoomContent/RoomControls/LeaveButton" to="." method="_on_leave_pressed"]
[connection signal="text_submitted" from="Margin/Content/ConnectionRow/NameEdit" to="." method="_on_name_submitted"]
