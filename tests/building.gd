extends TestBase
func run() -> void:
	_placement_blocks_multi_cell()
	_illegal_placement_rejected()
	_construction_completes()
	_destroyed_building_becomes_ruins()
	_placement_and_construction_deterministic()
	_commands_roundtrip_build_fields()
func _placement_blocks_multi_cell() -> void:
	var grid := NavGrid.new(16, 16)
	var sim := GameSim.new(grid, 51)
	var id := sim.issue_place(BuildingTypes.HOUSE, 4, 4, 0)
	check_true(id >= 0, "house placed on open ground")
	check_true(grid.is_building_blocked(4, 4), "origin cell blocked")
	check_true(grid.is_building_blocked(5, 5), "far corner blocked")
	check_true(not grid.is_building_blocked(6, 4), "cell beyond width stays open")
	check_true(grid.is_blocked(4, 4), "building participates in pathing block")
func _illegal_placement_rejected() -> void:
	var grid := NavGrid.new(16, 16)
	grid.set_blocked(2, 2, true)
	var sim := GameSim.new(grid, 52)
	check_eq(sim.issue_place(BuildingTypes.HOUSE, 15, 15, 0), -1, "out of bounds rejected")
	check_eq(sim.issue_place(BuildingTypes.HOUSE, 2, 2, 0), -1, "terrain wall rejected")
	check_eq(sim.issue_place(BuildingTypes.UNAVAILABLE, 8, 8, 0), -1, "unknown type rejected")
	check_true(sim.issue_place(BuildingTypes.HOUSE, 8, 8, 0) >= 0, "free spot accepted")
	check_eq(sim.issue_place(BuildingTypes.HOUSE, 9, 9, 0), -1, "overlapping building rejected")
func _construction_completes() -> void:
	var grid := NavGrid.new(16, 16)
	var sim := GameSim.new(grid, 53)
	var building := sim.issue_place(BuildingTypes.HOUSE, 5, 5, 0)
	var builder := sim.spawn_unit(9, 6, 0, 50, 0, 0.0, 0.5)
	sim.issue_construct(builder, building)
	check_eq(sim.world.get_value(building, SimComponents.BUILDING, SimComponents.STATE), BuildingSystem.STATE_FOUNDATION, "starts as foundation")
	for i in 240:
		sim.simulate_tick()
	check_eq(sim.world.get_value(building, SimComponents.BUILDING, SimComponents.STATE), BuildingSystem.STATE_COMPLETE, "worker finishes construction")
	check_eq(sim.world.get_value(building, SimComponents.BUILDING, SimComponents.PROGRESS), BuildingTypes.build_ticks(BuildingTypes.HOUSE), "progress reaches maximum")
	check_eq(sim.world.get_value(building, SimComponents.HEALTH, SimComponents.HP), BuildingTypes.max_hp(BuildingTypes.HOUSE), "completed building holds full health")
	check_true(not sim.world.has_component(builder, SimComponents.CONSTRUCT), "worker releases construction task")
func _destroyed_building_becomes_ruins() -> void:
	var grid := NavGrid.new(16, 16)
	for wall_y in 16:
		grid.set_blocked(3, wall_y, true)
	var sim := GameSim.new(grid, 54)
	var building := sim.issue_place(BuildingTypes.HOUSE, 6, 6, 0)
	sim.spawn_unit(8, 7, 1, 100, 60, 3.0, 0.0)
	for i in 240:
		sim.simulate_tick()
	check_eq(sim.world.get_value(building, SimComponents.BUILDING, SimComponents.STATE), BuildingSystem.STATE_RUINS, "building collapses into ruins")
	check_true(sim.world.is_alive(building), "ruins keep their entity")
	check_true(not grid.is_building_blocked(6, 6), "ruins release building block")
	check_true(not grid.is_blocked(7, 7), "ruins are walkable")
	check_true(grid.is_terrain_blocked(3, 3), "ruins keep terrain wall intact")
	check_true(not sim.world.has_component(building, SimComponents.HEALTH), "ruins no longer targetable")
	check_true(sim.field_for(6, 6).reachable(9, 9), "path reopens through ruins")
func _placement_and_construction_deterministic() -> void:
	check_eq(_run_build_cycle(), _run_build_cycle(), "identical build cycles share checksum")
func _run_build_cycle() -> int:
	var grid := NavGrid.new(20, 20)
	var sim := GameSim.new(grid, 55)
	var building := sim.issue_place(BuildingTypes.BARRACKS, 4, 4, 0)
	var builder := sim.spawn_unit(10, 6, 0, 50, 0, 0.0, 0.4)
	sim.issue_construct(builder, building)
	for i in 160:
		sim.simulate_tick()
	return sim.world.checksum()
func _commands_roundtrip_build_fields() -> void:
	var original := LockstepCommand.new(1, LockstepCommand.Kind.PLACE_BUILDING, -1, 7, 9, -1, BuildingTypes.TOWER)
	var restored := LockstepCommand.from_array(original.to_array())
	check_eq(restored.kind, LockstepCommand.Kind.PLACE_BUILDING, "placement kind survives serialization")
	check_eq(restored.build_type, BuildingTypes.TOWER, "build type survives serialization")
	check_eq(restored.cell_x, 7, "placement cell x survives serialization")
	var legacy := LockstepCommand.from_array(PackedInt32Array([0, LockstepCommand.Kind.MOVE, 3, 4, 5]))
	check_eq(legacy.build_type, BuildingTypes.UNAVAILABLE, "short payload defaults build type")
